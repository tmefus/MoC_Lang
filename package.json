{
  "name": "moc-lang",
  "displayName": "MoC Language",
  "description": "Syntax highlighting for MoC language",
  "version": "0.1.1",
  "publisher": "mefus",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [{
      "id": "moc",
      "aliases": ["MoC", "moc"],
      "extensions": [".moc"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "moc",
      "scopeName": "source.moc",
      "path": "./syntaxes/moc.tmLanguage.json"
    }]
  }
}